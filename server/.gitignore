# Every secret this server has lives here.
config.yaml

# Server keys.  Only the CA certificate is meant to be shared; it is embedded
# in the firmware, so it can be committed if a deployment wants to.
certs/*.key
certs/*.crt
certs/*.srl
# Firmware header left by certs/gen_certs.sh, to copy into firmware/src.
certs/ca_cert.h

# Published firmware images and manifests.
fw/

logs/
*.log
__pycache__/
*.pyc
.venv/
