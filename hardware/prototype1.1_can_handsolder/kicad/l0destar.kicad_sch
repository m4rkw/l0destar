	(text "POWER RAILS\n\nVBAT\nVBAT_PROT\nVBAT_PROT_READ\nVBAT_SWITCHED\nVIGN\nVIGN_PROT\nVGND\nSGND\n+3.3V\n+3.3V_AUX\n+5V\n+5V_AUX\n\nSYSTEM GPIOS\n\nSTATUS\nIGN_SENSE\nRESET_SIGNAL\n\nPOWER CONTROL\n\nAUX_SW\nVBAT_ALRT\nRLY_SET\nRLY_RST\nRLY_SET_FB\nRLY_RST_FB\n\nCOMMS\n\nI2C_SDA\nI2C_SCL\nACCELL_INT1\nACCELL_INT2\nCAN_CS\nCAN_SDO\nCAN_SDI\nCAN_SCK\nCAN_INT\nK_RX\nK_TX\nL_SEND\nL_RECV\nGPIO1\nGPIO2\nGPIO3\nGPIO4\nGPIO5\nGPIO6"
		(exclude_from_sim no)
		(at 197.104 68.326 0)
		(effects
			(font
