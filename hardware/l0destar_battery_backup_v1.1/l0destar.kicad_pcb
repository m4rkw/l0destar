				)
			)
		)
		(property "Description" "Wake pulse flying capacitor, 50 V part so it keeps ~4 uF at 12 V bias. Sits on VBOOST: charged to VBAT through R22 while the boost is off, its top is carried to ~12.4 V by the 0 -> 9.6 V step at boost start and dumps into the tracker's 236k ignition divider (tau ~0.9 s: above 8 V for ~0.4 s). Swings to -9 V when car power returns, which a ceramic does not mind, and re-arms through R22 in ~20 s"
			(at 0 0 90)
			(layer "F.Fab")
			(hide yes)
			(uuid "4cf29075-3652-4d0f-b3c2-9fe76d186076")
			(effects
