	(text "MCU overvoltage protection\nP-channel MOSFET controlled by an ATL431B shunt reference watching the rail via a divider\nIf the rail exceeds the threshold the ATL431 turns a PNP on which drags the MOSFET gate up and opens the path\nShould trip at 4.95V and release at 4.80V\nS11R4 and S11R5 should be anti-sulfur AEC-Q200 parts and conformal coated\nIdeal diode for reverse current protection and bulk ceramics"
		(exclude_from_sim no)
		(at 179.07 173.355 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a28edb93-b958-4a7a-9d34-bff318ab6d7b")
	)
