		(uuid "11134ae3-6564-44f3-823a-2f73edce0bf4")
	)
	(text "Ignition wake pulse: at boost start the 0 -> 9.6 V step lifts C17 (pre-charged to VBAT via R22) to ~12 V; Q7, switched on by Q6 from\nVBOOST, puts it on IGN via D3/R21 for ~0.4 s to wake a sleeping tracker."
		(exclude_from_sim no)
		(at 90.17 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3b858e51-0eb1-4fe0-9f11-e1e55ad7ec6a")
	)
