# MCUboot image-signing key (see sysbuild.conf / FOTA.md) — the public half is
# baked into every deployed bootloader, so keep a backup somewhere safe.
mcuboot_priv.pem
# nRF Cloud onboarding CA (contains a private key) + generated artifacts
onboarding/
# IF MCU: cloned upstream repo + build output
ifmcu/.makerdiary-repo/
