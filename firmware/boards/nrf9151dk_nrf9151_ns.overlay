/* The tracker drives I2C and the K-lines as plain GPIO on gpio0,
 * so any DK peripheral whose default pinctrl claims one of those pins must be
 * disabled to hand the pin back to the app.  (UART0 keeps its default pins
 * P0.14/15/26/27 — none of which the tracker uses — for the USB VCOM console.)
 */

/* I2C2 default pinctrl owns P0.30/P0.31 — needed for RLY_RST / IGN_SENSE. */
&i2c2 {
	status = "disabled";
};

/* SPI3 default pinctrl owns P0.11/P0.12 — needed for VBAT_ALRT / RLY_SET. */
&spi3 {
	status = "disabled";
};

/* Use DK-default UART0 pins (routed through J-Link to USB VCOM) */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ hw-flow-control;
};
