# Copy this file to local.conf and fill in your values.
# local.conf is gitignored and picked up automatically by build.sh.

# --- carrier board ---------------------------------------------------------
# Which l0destar PCB this build targets.  Selecting a board sets the whole
# GPIO map, fitted-hardware flags and power-domain sequencing (see
# Kconfig.boards).  Default is v3.4; a DK or Connect Kit on a breadboard is
# the bench profile.
# CONFIG_APP_BOARD_BENCH=y
# CONFIG_APP_BOARD_L0DESTAR_V3_4=y      (default)
# CONFIG_APP_BOARD_L0DESTAR_V3_3=y
# CONFIG_APP_BOARD_L0DESTAR_V3_2=y
# CONFIG_APP_BOARD_L0DESTAR_V3_1=y
# CONFIG_APP_BOARD_L0DESTAR_V3_0=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_CAN=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_KLINE=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_MICRO=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_CAN=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_KLINE=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_MICRO=y
# CONFIG_APP_BOARD_L0DESTAR_V2_1=y
# CONFIG_APP_BOARD_L0DESTAR_V2_1_MINI=y
#
# v3.1 and later: the OBD interface fitted, as bridged on the selection pads -
# 0 none, 1 CAN, 2 K-wire:
# CONFIG_APP_OBD_MODE=2
#
# v3.0 only: the PCB carries both OBD circuits; match the jumper/population
# of the actual board by disabling the one that isn't in use:
# CONFIG_APP_BOARD_HAS_CAN=n
# CONFIG_APP_BOARD_HAS_KLINE=n

# --- secrets (required) ----------------------------------------------------
# This unit's key, from `openssl rand -hex 32`.  Enrol the unit on the server
# with the same key: tools/adddevice.py <imei> <name> --psk <key>
CONFIG_APP_PSK_HEX=""

# --- network (required) ----------------------------------------------------
CONFIG_APP_SERVER_HOST=""
CONFIG_APP_APN=""
# Only if the server publishes its UDP listener under another port number:
# CONFIG_APP_SERVER_PORT=65480

# --- Traccar instead of the l0destar server --------------------------------
# Report to a Traccar server with its OsmAnd protocol (TRACCAR.md).  Register
# the device there with its IMEI as the identifier first.  SERVER_HOST and
# PSK_HEX above are then unused.
# CONFIG_APP_TRACCAR=y
# CONFIG_APP_TRACCAR_HOST="traccar.example.org"
# CONFIG_APP_TRACCAR_PORT=5055
# CONFIG_APP_TRACCAR_ID=""            # empty: the IMEI
# CONFIG_APP_TRACCAR_SEC_TAG=-1       # a modem sec_tag with the CA for HTTPS

# --- preferences -----------------------------------------------------------
# CONFIG_APP_MOVEMENT_ALARM=n
# CONFIG_LOG_MODE_IMMEDIATE=y

# --- public demos ----------------------------------------------------------
# Mask lat/lon in everything printed on the console (telemetry records, locate
# alerts, the board test's fix line).  What goes to the server is unchanged.
# board_test.sh copies this into its generated overlay too.
# CONFIG_APP_DEMO_MODE=y

# --- board test (board_test.sh) --------------------------------------------
# Drop the GPS fix coordinates from the board-test line altogether, rather
# than masking them the way APP_DEMO_MODE does.  Wins if both are set.
# CONFIG_APP_BOARD_TEST_HIDE_COORDS=y

# --- intervals (seconds) ---------------------------------------------------
# CONFIG_APP_ENGINE_OFF_LOOP_INTERVAL=0
# CONFIG_APP_IGNITION_ON_SLEEP_INTERVAL=30
# CONFIG_APP_VOLTAGE_POLL_INTERVAL=5
# CONFIG_APP_BATTERY_CHECK_INTERVAL=86400
# CONFIG_APP_NETWORK_REGISTRATION_TIMEOUT=60
# CONFIG_APP_NETWORK_RETRY_INTERVAL=300
# With the ignition off, how long the modem may search for a network before
# the unit gives up and sleeps until the next timed report (0 = no limit).
# CONFIG_APP_NETWORK_SEARCH_TIMEOUT=300
# Each consecutive timed wake that finds no network doubles the wait until
# the next one, up to this ceiling (0 = no backoff).
# CONFIG_APP_NO_SIGNAL_MAX_INTERVAL=86400
# CONFIG_APP_GPS_FIX_TIMEOUT_MS=60000

# --- voltage thresholds (millivolts) ---------------------------------------
# CONFIG_APP_BATTERY_WARNING_MV=11900
# CONFIG_APP_BATTERY_POWEROFF_MV=11800
# CONFIG_APP_SLEEP_SAFETY_MV=12000
# CONFIG_APP_ENGINE_RUNNING_MV=13000

# --- accelerometer / movement ----------------------------------------------
# CONFIG_APP_ACC_MOVEMENT_THRESHOLD=150
# CONFIG_APP_MOVEMENT_CONFIRM_MS=10000
# CONFIG_APP_MOVEMENT_CONFIRM_HITS=6
# CONFIG_APP_MOVEMENT_INACTIVITY_RESET=1800

# --- coast-to-stop ---------------------------------------------------------
# CONFIG_APP_COAST_STOP_SPEED_KMH_X10=50
# CONFIG_APP_COAST_MAX_ITERATIONS=60

# --- error escalation ------------------------------------------------------
# Modem recovery is time-based and only counts time spent *registered but
# unable to send*.  Coverage loss is left to the modem, which handles it.
# CONFIG_APP_MODEM_STUCK_CFUN_S=600
# CONFIG_APP_MODEM_STUCK_RESET_S=1800

# --- K-wire (ISO 14230-1) vehicle session init — in-car bring-up only ------
# Opens a KWP2000 session at boot, prints the result on the console and
# parks without starting the tracker.  See KWIRE.md.  Values below are the
# reference vehicle, a 2006 Toyota Harrier 2.4 (ACU30): its ECUs answer the
# 5-baud init on their own addresses at 9600 baud, on K alone.
# CONFIG_APP_KLINE_DISCOVER=y
# CONFIG_APP_KLINE_BAUD=9600
# CONFIG_APP_KLINE_INIT_ADDRS="13,29,58,B4"
# CONFIG_APP_KLINE_INIT_FAST=n
# CONFIG_APP_KLINE_INIT_SWEEP=n
# CONFIG_APP_KLINE_INIT_DIAG=n

# --- accelerometer alert backoff -------------------------------------------
# After a high-priority impact/tilt/movement alert, downgrade further ones for
# this long so a single event (opening the glovebox the tracker sits in) does
# not produce a string of urgent notifications.
# CONFIG_APP_ACCEL_ALERT_BACKOFF_S=300
# CONFIG_APP_ACCEL_ALERT_BACKOFF_PRIORITY=0
