# Copy this file to local.conf and fill in your values.
# local.conf is gitignored and picked up automatically by build.sh.

# --- carrier board ---------------------------------------------------------
# Which l0destar PCB this build targets.  Selecting a board sets the whole
# GPIO map, fitted-hardware flags and power-domain sequencing (see
# Kconfig.boards).  Default is the bench (DK / Connect Kit + breadboard).
# CONFIG_APP_BOARD_L0DESTAR_V2_1=y
# CONFIG_APP_BOARD_L0DESTAR_V2_1_MINI=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_CAN=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_KLINE=y
# CONFIG_APP_BOARD_L0DESTAR_V2_5_MICRO=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_CAN=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_KLINE=y
# CONFIG_APP_BOARD_L0DESTAR_V2_6_MICRO=y
# CONFIG_APP_BOARD_L0DESTAR_V3_0=y
#
# v3.0 only: the PCB carries both OBD circuits; match the jumper/population
# of the actual board by disabling the one that isn't in use:
# CONFIG_APP_BOARD_HAS_CAN=n
# CONFIG_APP_BOARD_HAS_KLINE=n

# --- secrets (required) ----------------------------------------------------
CONFIG_APP_PSK_HEX=""

# --- network (required) ----------------------------------------------------
CONFIG_APP_SERVER_HOST=""
CONFIG_APP_SERVER_PORT=0
CONFIG_APP_APN=""

# --- preferences -----------------------------------------------------------
# CONFIG_APP_MOVEMENT_ALARM=n
# CONFIG_LOG_MODE_IMMEDIATE=y

# --- public demos ----------------------------------------------------------
# Mask lat/lon in everything printed on the console (telemetry records, locate
# alerts, the board test's fix line).  What goes to the server is unchanged.
# board_test.sh copies this into its generated overlay too.
# CONFIG_APP_DEMO_MODE=y

# --- board test (board_test.sh) --------------------------------------------
# Drop the GPS fix coordinates from the board-test line altogether, rather
# than masking them the way APP_DEMO_MODE does.  Wins if both are set.
# CONFIG_APP_BOARD_TEST_HIDE_COORDS=y

# --- intervals (seconds) ---------------------------------------------------
# CONFIG_APP_ENGINE_OFF_LOOP_INTERVAL=0
# CONFIG_APP_IGNITION_ON_SLEEP_INTERVAL=30
# CONFIG_APP_VOLTAGE_POLL_INTERVAL=5
# CONFIG_APP_BATTERY_CHECK_INTERVAL=86400
# CONFIG_APP_NETWORK_REGISTRATION_TIMEOUT=60
# CONFIG_APP_NETWORK_RETRY_INTERVAL=300
# CONFIG_APP_GPS_FIX_TIMEOUT_MS=60000

# --- voltage thresholds (millivolts) ---------------------------------------
# CONFIG_APP_BATTERY_WARNING_MV=11900
# CONFIG_APP_BATTERY_POWEROFF_MV=11800
# CONFIG_APP_SLEEP_SAFETY_MV=12000
# CONFIG_APP_ENGINE_RUNNING_MV=13000

# --- accelerometer / movement ----------------------------------------------
# CONFIG_APP_ACC_MOVEMENT_THRESHOLD=150
# CONFIG_APP_MOVEMENT_CONFIRM_MS=3000
# CONFIG_APP_MOVEMENT_CONFIRM_HITS=2
# CONFIG_APP_MOVEMENT_INACTIVITY_RESET=1800

# --- coast-to-stop ---------------------------------------------------------
# CONFIG_APP_COAST_STOP_SPEED_KMH_X10=50
# CONFIG_APP_COAST_MAX_ITERATIONS=60

# --- error escalation ------------------------------------------------------
# CONFIG_APP_GSM_ESCALATION_POWERCYCLE=3
# CONFIG_APP_GSM_ESCALATION_SLEEP=5
# CONFIG_APP_GSM_RECOVERY_SLEEP_INTERVAL=300
