	default 60000

config APP_GPS_COLD_FIX_TIMEOUT_MS
	int "GPS cold-start fix timeout (ms)"
	default 300000
	help
	  Timeout for the first GNSS fix after a cold boot (no cached
	  almanac/ephemeris).  Without A-GPS, a cold TTFF can take 2-5
	  minutes depending on signal and antenna-sharing with LTE.

