# --- accelerometer / movement ----------------------------------------------

config APP_ACC_MOVEMENT_THRESHOLD
	int "Movement delta threshold (milli-g)"
	default 150

config APP_MOVEMENT_CONFIRM_MS
	int "Movement confirmation window (ms)"
	default 10000

config APP_MOVEMENT_CONFIRM_HITS
	int "Required above-threshold samples to confirm"
	default 20

config APP_MOVEMENT_INACTIVITY_RESET
	int "Inactivity reset timer (seconds)"
	default 1800

config APP_MOVEMENT_ALARM
	bool "Enable movement alarm"
	default n

config APP_CRASH_THRESHOLD_MG
	int "Impact alert threshold (milli-g)"
	default 4000
	help
	  Acceleration delta that triggers an impact alert while awake.
	  Production ~4000 (4 g); set ~1200 in local.conf for bench testing —
	  a firm rap on the desk reaches 1.5-3 g.  Rounded down to 125 mg
	  steps (±8 g FS / 64).

config APP_TOW_TILT_DEG
	int "Tow/jack tilt alert threshold (degrees, 0 = disabled)"
	default 6
	help
	  While asleep, the gravity vector is compared against a reference
	  snapped at sleep entry.  A sustained tilt beyond this angle raises a
	  tow/jack alert — catches slow, vibration-free lifts (flatbed ramps
	  reach 10-15°, jacking a corner 3-8°) that never trip the movement
	  wake.  Suspension settling is ~1-2°, so keep above ~4.

config APP_TOW_POLL_S
	int "Tow tilt poll interval during sleep (seconds)"
	default 30
	help
	  Sleep-loop wake cadence for the tilt check.  Each poll is a single
	  accelerometer read (~ms); the power cost is negligible on vehicle
	  power.

config APP_PARKED_IMPACT_MG
	int "Parked impact alert threshold (milli-g)"
	default 800
	help
	  Peak | |a| - 1g | from the FIFO ring during an unconfirmed movement
	  wake (a "transient bump") that raises a parked-impact alert instead
	  of being ignored.  Sleep runs the accel at ±2 g, so hard hits clip:
	  the measurable deviation caps around ~1000-1200 mg — thresholds
	  above that can never fire.

