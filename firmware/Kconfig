mainmenu "l0destar firmware"

config APP_LOG_LEVEL
	int "Application log level"
	default 3
	help
	  Per-module Zephyr log level for app modules (0=off, 1=err, 2=wrn,
	  3=inf, 4=dbg).

config APP_PROVISION_MODE
	bool "Provisioning build: AT-host bridge for nRF Cloud onboarding"
	default n
	help
	  When set, main() brings up the modem and idles with the AT Host
	  library bridging nrfcloud-utils to the modem over the console UART,
	  instead of running the tracker.  Enabled via prov.conf
	  (PROV=1 ./build.sh).  Onboard with device_credentials_installer
	  --cmd-type at, then reflash the normal build; the device key/cert
	  persist in modem NVM at CONFIG_NRF_CLOUD_SEC_TAG.

# --- board selection / pin assignments --------------------------------------
# The carrier-board choice, per-board GPIO maps, capability flags and
# power-domain topology all live in Kconfig.boards.  Select the board in
# local.conf (e.g. CONFIG_APP_BOARD_L0DESTAR_V3_0=y); individual pins can
# still be overridden after the board defaults are applied.

rsource "Kconfig.boards"

# --- hardware presence / debug overrides ------------------------------------

config APP_RELAY_CONNECTED
	bool "Latching relay fitted"
	default n if APP_BOARD_IS_L0DESTAR && !APP_BOARD_L0DESTAR_V2_1 && !APP_BOARD_L0DESTAR_V2_1_MINI
	default y
	help
	  When disabled, relay_init/set/reset are no-ops and the relay pins are
	  never driven.  relay_init() self-detects an absent relay (both feedback
	  lines low) and falls back to no-ops, so this can stay enabled on a
	  bench without the relay wired.

config APP_DEBUG_IGNITION
	int "Force ignition state (-1 = read the GPIO)"
	default -1
	help
	  Debug override for benches without the ignition sense line wired:
	  0 = ignition ON, 1 = ignition OFF, -1 = live GPIO read.

config APP_DEBUG_BATTERY_MV
	int "Force battery voltage in mV (0 = read the INA228)"
	default 0
	help
	  Debug override for benches without the INA228/vehicle supply:
	  e.g. 13000 reports 13.0 V.  0 = live reading.

config APP_ALWAYS_ON
	bool "Keep relay set regardless of ignition state"
	default n
	help
	  When enabled, relay_set() is called at boot and the relay is never
	  reset by the state machine.  Use for installations where the tracker
	  supplies its own load and should stay powered continuously.

config APP_ACCEL_TEST
	bool "Stream accelerometer data at boot"
	default n
	help
	  At startup, print accel/gyro/temp readings continuously at 10 Hz
	  for noise analysis.  Loops forever; does not enter the main loop.

config APP_KLINE_TEST
	bool "Run the L9637D K-line bring-up test at boot"
	default n
	help
	  At startup, stream a run of bytes K1 -> K2 and K2 -> K1 over the shared
	  K-line to verify the two transceivers talk to each other across the
	  wire.  Bench bring-up aid; leave off in production.

config APP_PSK_HEX
	string "32-byte device PSK as 64 hex chars"
	default ""
	help
	  Pre-shared key for the ChaCha20-Poly1305 telemetry envelope.  Leave
	  empty to fall back to PSK_HEX_DEFAULT in config.h (the placeholder
	  all-zero key disables sends).  Real device keys should be provisioned
	  out-of-band, never checked in.

config APP_TRANSPORT_TLS
	bool "Use TLS (TCP) instead of DTLS (UDP) for telemetry"
	default y
	help
	  When enabled, telemetry uses modem-offloaded TLS 1.2 over TCP
	  (port TLS_PORT, 65481) with a fresh connection per send.  When
	  disabled, telemetry uses DTLS 1.2 over UDP (port DTLS_PORT, 65482)
	  with a persistent session.  TLS/TCP is the more reliable path over
	  cellular NAT/firewalls (UDP bindings time out and inbound UDP to a
	  self-hosted endpoint is easily dropped).  Both use the same CA at
	  TLS_SEC_TAG, the same wire framing, and the same server.

config APP_SERVER_HOST
	string "Telemetry server hostname"
	default ""
	help
	  Telemetry endpoint hostname (used for DNS resolution and TLS SNI).
	  Leave empty to fall back to HOSTNAME in config.h.

config APP_APN
	string "Cellular APN"
	default ""
	help
	  Network APN.  Leave empty to fall back to DEFAULT_APN in config.h.

