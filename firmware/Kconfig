mainmenu "l0destar firmware"

config APP_LOG_LEVEL
	int "Application log level"
	default 3
	help
	  Per-module Zephyr log level for app modules (0=off, 1=err, 2=wrn,
	  3=inf, 4=dbg).

config APP_PROVISION_MODE
	bool "Provisioning build: AT-host bridge for nRF Cloud onboarding"
	default n
	help
	  When set, main() brings up the modem and idles with the AT Host
	  library bridging nrfcloud-utils to the modem over the console UART,
	  instead of running the tracker.  Enabled via prov.conf
	  (PROV=1 ./build.sh).  Onboard with device_credentials_installer
	  --cmd-type at, then reflash the normal build; the device key/cert
	  persist in modem NVM at CONFIG_NRF_CLOUD_SEC_TAG.

# --- board selection / pin assignments --------------------------------------
# The carrier-board choice, per-board GPIO maps, capability flags and
# power-domain topology all live in Kconfig.boards.  Select the board in
# local.conf (e.g. CONFIG_APP_BOARD_L0DESTAR_V3_0=y); individual pins can
# still be overridden after the board defaults are applied.

rsource "Kconfig.boards"

# --- hardware presence / debug overrides ------------------------------------

config APP_RELAY_CONNECTED
	bool "Latching relay fitted"
	default n if APP_BOARD_IS_L0DESTAR && !APP_BOARD_L0DESTAR_V2_1 && !APP_BOARD_L0DESTAR_V2_1_MINI
	default y
	help
	  When disabled, relay_init/set/reset are no-ops and the relay pins are
	  never driven.  relay_init() self-detects an absent relay (both feedback
	  lines low) and falls back to no-ops, so this can stay enabled on a
	  bench without the relay wired.

config APP_DEBUG_IGNITION
	int "Force ignition state (-1 = read the GPIO)"
	default -1
	help
	  Debug override for benches without the ignition sense line wired:
	  0 = ignition ON, 1 = ignition OFF, -1 = live GPIO read.

config APP_DEBUG_BATTERY_MV
	int "Force battery voltage in mV (0 = read the INA228)"
	default 0
	help
	  Debug override for benches without the INA228/vehicle supply:
	  e.g. 13000 reports 13.0 V.  0 = live reading.

config APP_ALWAYS_ON
	bool "Keep relay set regardless of ignition state"
	default n
	help
	  When enabled, relay_set() is called at boot and the relay is never
	  reset by the state machine.  Use for installations where the tracker
	  supplies its own load and should stay powered continuously.

config APP_ACCEL_TEST
	bool "Stream accelerometer data at boot"
	default n
	help
	  At startup, print accel/gyro/temp readings continuously at 10 Hz
	  for noise analysis.  Loops forever; does not enter the main loop.

config APP_OBD_MODE
	int "OBD interface mode (0=none, 1=CAN, 2=K-line)"
	default 0
	help
	  Which OBD interface is populated on a v3.1 board.  The jumper pads
	  select the electrical path; this tells firmware which rails to test
	  and which protocol driver to start.
	    0 = no OBD interface (S5R1-S5R7 all open)
	    1 = CAN bus (3.3V OBD only)
	    2 = K-line / ISO-9141 (3.3V + 12V OBD)
	  Ignored on boards other than v3.1.

config APP_CAN_TEST
	bool "Run the CAN bus loopback test at boot"
	default n
	help
	  At startup, send a CAN frame (ID 0x100, "PING") and wait for a
	  reply (ID 0x101, "PONG") from an external adapter.  Loops forever
	  after the test; does not enter the main loop.

config APP_KLINE_TEST
	bool "Run the L9637D K-line bring-up test at boot"
	default n
	help
	  At startup, stream a run of bytes K1 -> K2 and K2 -> K1 over the shared
	  K-line to verify the two transceivers talk to each other across the
	  wire.  Bench bring-up aid; leave off in production.

config APP_PSK_HEX
	string "32-byte device PSK as 64 hex chars"
	default ""
	help
	  Pre-shared key for the ChaCha20-Poly1305 telemetry envelope.  Leave
	  empty to fall back to PSK_HEX_DEFAULT in config.h (the placeholder
	  all-zero key disables sends).  Real device keys should be provisioned
	  out-of-band, never checked in.

config APP_SERVER_HOST
	string "Telemetry server hostname"
	default ""
	help
	  Telemetry endpoint hostname (used for DNS resolution and TLS SNI).
	  Leave empty to fall back to HOSTNAME in config.h.

config APP_APN
	string "Cellular APN"
	default ""
	help
	  Network APN.  Leave empty to fall back to DEFAULT_APN in config.h.

# --- over-the-air updates ---------------------------------------------------

menuconfig APP_FOTA
	bool "Over-the-air application updates"
	default y
	select FOTA_DOWNLOAD
	select DOWNLOADER
	select DFU_TARGET
	select DFU_TARGET_MCUBOOT
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	select STREAM_FLASH
	select FLASH
	select FLASH_MAP
	select REST_CLIENT
	select HTTP_CLIENT
	help
	  Fetch a version manifest over HTTPS at power-on and on each engine-off
	  telemetry wake, and install the image it advertises when that version
	  is newer than this build.  Requires MCUboot (sysbuild.conf) — the
	  download lands in the secondary slot and the bootloader swaps it in on
	  the next boot.  See FOTA.md.

if APP_FOTA

config APP_FOTA_HOST
	string "Update server hostname"
	default ""
	help
	  Host serving the manifest and the signed images.  Leave empty to reuse
	  APP_SERVER_HOST (the telemetry endpoint), which is also what the CA at
	  APP_FOTA_SEC_TAG was issued for.

config APP_FOTA_PORT
	int "Update server port"
	default 65481
	help
	  Defaults to the telemetry TLS port: public 443 terminates on a
	  different host, but this port is already forwarded to the tracker
	  server, whose TLS listener sniffs the first two bytes and serves
	  HTTP range requests for /fw/* alongside the telemetry protocol
	  (_handle_fw_http in the server's main.py).

config APP_FOTA_SEC_TAG
	int "Modem sec_tag holding the update server's CA (-1 = plain HTTP)"
	default 42
	help
	  modem_provision_tls() installs the l0destar CA from src/ca_cert.h
	  here on first boot, so the same private CA authenticates telemetry
	  and updates.  It is deliberately NOT the telemetry TLS_SEC_TAG:
	  past DTLS/PSK experiments left extra credential types on tag 1 in
	  modem NVM, and a mixed tag makes certificate-mode TLS connect()
	  fail with EINVAL.  A dedicated tag holds one CA chain and nothing
	  else.  Set -1 to fetch over plain HTTP; the image is still
	  signature-checked by MCUboot, but the manifest and the URL it names
	  are then unauthenticated.

config APP_FOTA_MANIFEST_PATH
	string "Manifest path on the update server"
	default "/fw/manifest.txt"
	help
	  Requested with ?imei=<imei>&v=<running version> appended so a dynamic
	  endpoint can stage rollouts per device.  A static file server ignores
	  the query string.

config APP_FOTA_MIN_BATTERY_MV
	int "Minimum battery voltage to install an update (mV)"
	default 12000
	help
	  Below this the check still runs but the download is deferred to the
	  next one, so a weak battery is never asked to carry a multi-minute
	  radio session plus a flash write.

config APP_FOTA_REQUIRE_BATTERY_READING
	bool "Block updates when the battery voltage is unknown"
	default n
	help
	  A reading below IMPLAUSIBLE_VOLTAGE (5 V) means no INA228 rather than
	  a flat battery — on the bench there is no vehicle supply at all.  By
	  default that case is allowed to update; enable this to require a real
	  measurement above the threshold instead.

config APP_FOTA_RETRY_HOLDOFF_S
	int "Holdoff after a failed update attempt (seconds)"
	default 600
	help
	  Checks are driven by the server (fota=<version> on each telemetry
	  response) plus one unconditional check at power-on, so there is no
	  periodic polling to rate-limit.  This holdoff only gates retries
	  after a failed attempt — the server keeps advertising the same
	  version on every response, and without it each send would burn a
	  fresh download attempt.  Doubles per consecutive failure, up to 8x.
	  A bare `fota` command overrides it.

config APP_FOTA_MANIFEST_TIMEOUT_S
	int "Manifest request timeout (seconds)"
	default 30

config APP_FOTA_DOWNLOAD_TIMEOUT_S
	int "Image download timeout (seconds)"
	default 1200
	help
	  Upper bound on the whole download.  A ~300 KB image over LTE-M
	  typically takes 2-5 minutes; the watchdog is fed throughout.

config APP_FOTA_FRAGMENT_SIZE
	int "HTTP range request size (0 = single continuous response)"
	default 0

endif # APP_FOTA

