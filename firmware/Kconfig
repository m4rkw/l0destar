mainmenu "l0destar firmware"

config APP_LOG_LEVEL
	int "Application log level"
	default 3
	help
	  Per-module Zephyr log level for app modules (0=off, 1=err, 2=wrn,
	  3=inf, 4=dbg).

config APP_PROVISION_MODE
	bool "Provisioning build: AT-host bridge for nRF Cloud onboarding"
	default n
	help
	  When set, main() brings up the modem and idles with the AT Host
	  library bridging nrfcloud-utils to the modem over the console UART,
	  instead of running the tracker.  Enabled via prov.conf
	  (PROV=1 ./build.sh).  Onboard with device_credentials_installer
	  --cmd-type at, then reflash the normal build; the device key/cert
	  persist in modem NVM at CONFIG_NRF_CLOUD_SEC_TAG.

config DK_PIN_WORKAROUNDS
	bool "Use DK-compatible pin assignments"
	default n
	help
	  Override pins that conflict with DK onboard hardware:
	  K-line from P0.14/P0.15 to P0.8/P0.9 (debugger VCOM),
	  accel SCL from P0.17 to P0.18 (ADC buffer).

config APP_ALWAYS_ON
	bool "Keep relay set regardless of ignition state"
	default n
	help
	  When enabled, relay_set() is called at boot and the relay is never
	  reset by the state machine.  Use for installations where the tracker
	  supplies its own load and should stay powered continuously.

config APP_PSK_HEX
	string "32-byte device PSK as 64 hex chars"
	default ""
	help
	  Pre-shared key for the ChaCha20-Poly1305 telemetry envelope.  Leave
	  empty to fall back to PSK_HEX_DEFAULT in config.h (the placeholder
	  all-zero key disables sends).  Real device keys should be provisioned
	  out-of-band, never checked in.

config APP_SERVER_HOST
	string "Telemetry server hostname"
	default ""
	help
	  Telemetry endpoint hostname (used for DNS resolution and TLS SNI).
	  Leave empty to fall back to HOSTNAME in config.h.

config APP_APN
	string "Cellular APN"
	default ""
	help
	  Network APN.  Leave empty to fall back to DEFAULT_APN in config.h.

# --- intervals (seconds) ---------------------------------------------------

config APP_ENGINE_OFF_LOOP_INTERVAL
	int "Engine-off telemetry interval (0=disabled)"
	default 0

config APP_IGNITION_ON_SLEEP_INTERVAL
	int "Send cadence while ignition on, engine off"
	default 30

config APP_VOLTAGE_POLL_INTERVAL
	int "Battery sample cadence in IDLE"
	default 5

config APP_BATTERY_CHECK_INTERVAL
	int "Battery check interval during deep sleep"
	default 86400

config APP_NETWORK_REGISTRATION_TIMEOUT
	int "Network registration timeout"
	default 60

config APP_NETWORK_RETRY_INTERVAL
	int "Network retry interval"
	default 300

config APP_GPS_FIX_TIMEOUT_MS
	int "GPS fix timeout (ms)"
	default 60000

config APP_GPS_COLD_FIX_TIMEOUT_MS
	int "GPS cold-start fix timeout (ms)"
	default 300000
	help
	  Timeout for the first GNSS fix after a cold boot (no cached
	  almanac/ephemeris).  Without A-GPS, a cold TTFF can take 2-5
	  minutes depending on signal and antenna-sharing with LTE.

# --- voltage thresholds (millivolts to avoid Kconfig float limitation) ------

config APP_BATTERY_WARNING_MV
	int "Battery warning level (mV)"
	default 11900

config APP_BATTERY_POWEROFF_MV
	int "Battery power-off level (mV)"
	default 11800

config APP_SLEEP_SAFETY_MV
	int "Sleep safety voltage (mV)"
	default 12000

config APP_ENGINE_RUNNING_MV
	int "Engine running voltage threshold (mV)"
	default 13000

# --- accelerometer / movement ----------------------------------------------

config APP_ACC_MOVEMENT_THRESHOLD
	int "Movement delta threshold (milli-g)"
	default 150

config APP_MOVEMENT_CONFIRM_MS
	int "Movement confirmation window (ms)"
	default 3000

config APP_MOVEMENT_CONFIRM_HITS
	int "Required above-threshold samples to confirm"
	default 2

config APP_MOVEMENT_INACTIVITY_RESET
	int "Inactivity reset timer (seconds)"
	default 1800

config APP_MOVEMENT_ALARM
	bool "Enable movement alarm"
	default n

# --- coast-to-stop ---------------------------------------------------------

config APP_COAST_STOP_SPEED_KMH_X10
	int "Coast stop speed threshold (km/h * 10)"
	default 50

config APP_COAST_MAX_ITERATIONS
	int "Coast-to-stop max iterations"
	default 60

# --- error escalation ------------------------------------------------------

config APP_GSM_ESCALATION_POWERCYCLE
	int "Send failures before modem powercycle"
	default 3

config APP_GSM_ESCALATION_SLEEP
	int "Send failures before sleep"
	default 5

config APP_GSM_RECOVERY_SLEEP_INTERVAL
	int "Recovery sleep interval (seconds)"
	default 300

config NRF_CLOUD_KEY
	string "nRF Cloud REST API key (service evaluation token)"
	default ""
	help
	  Bearer token passed in the Authorization header when fetching
	  A-GNSS data from api.nrfcloud.com.  Obtain from the nRF Cloud
	  dashboard → Service evaluation tokens.

