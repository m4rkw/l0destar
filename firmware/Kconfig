mainmenu "l0destar firmware"

config APP_LOG_LEVEL
	int "Application log level"
	default 3
	help
	  Per-module Zephyr log level for app modules (0=off, 1=err, 2=wrn,
	  3=inf, 4=dbg).

config APP_PROVISION_MODE
	bool "Provisioning build: AT-host bridge for nRF Cloud onboarding"
	default n
	help
	  When set, main() brings up the modem and idles with the AT Host
	  library bridging nrfcloud-utils to the modem over the console UART,
	  instead of running the tracker.  Enabled via prov.conf
	  (PROV=1 ./build.sh).  Onboard with device_credentials_installer
	  --cmd-type at, then reflash the normal build; the device key/cert
	  persist in modem NVM at CONFIG_NRF_CLOUD_SEC_TAG.

# --- board selection / pin assignments --------------------------------------
# The carrier-board choice, per-board GPIO maps, capability flags and
# power-domain topology all live in Kconfig.boards.  Select the board in
# local.conf (e.g. CONFIG_APP_BOARD_L0DESTAR_V3_0=y); individual pins can
# still be overridden after the board defaults are applied.

rsource "Kconfig.boards"

# --- hardware presence / debug overrides ------------------------------------

config APP_DEBUG_IGNITION
	int "Force ignition state (-1 = read the GPIO)"
	default -1
	help
	  Debug override for benches without the ignition sense line wired:
	  0 = ignition ON, 1 = ignition OFF, -1 = live GPIO read.

config APP_DEBUG_BATTERY_MV
	int "Force battery voltage in mV (0 = read the INA228)"
	default 0
	help
	  Debug override for benches without the INA228/vehicle supply:
	  e.g. 13000 reports 13.0 V.  0 = live reading.

config APP_ACCEL_TEST
	bool "Stream accelerometer data at boot"
	default n
	help
	  At startup, print accel/gyro/temp readings continuously at 10 Hz
	  for noise analysis.  Loops forever; does not enter the main loop.

config APP_VOLTAGE_TEST
	bool "Stream INA228 bus voltage at boot"
	default n
	help
	  At startup, read VBUS from the INA228 and print it continuously at
	  2 Hz.  Loops forever; does not enter the main loop.  Temporary bench
	  bring-up aid — leave off in production.  Has no effect while
	  APP_DEBUG_BATTERY_MV is set, which fakes the reading.

config APP_OBD_MODE
	int "OBD interface mode (0=none, 1=CAN, 2=K-line)"
	default 0
	help
	  Which OBD interface is populated on a v3.1/v3.2/v3.3 board.  The
	  jumper pads select the electrical path; this tells firmware which
	  rails to test and which protocol driver to start.
	    0 = no OBD interface (S5R1-S5R4 all open)
	    1 = CAN bus (S5R1 + S5R3; PP3V3_CAN via CAN_EN)
	    2 = K-wire / ISO 14230 (S5R2 + S5R4; PP3V3_K + PP12V_K via K_EN)
	  Ignored on boards other than v3.1+.

config APP_CAN_TEST
	bool "Run the CAN bus loopback test at boot"
	default n
	help
	  At startup, send a CAN frame (ID 0x100, "PING") and wait for a
	  reply (ID 0x101, "PONG") from an external adapter.  Loops forever
	  after the test; does not enter the main loop.

config APP_CAN_BENCH
	bool "Run the CAN bench-test agent at boot"
	default n
	help
	  At startup, bring up the MCP2518FD at 500 kbps CAN 2.0 and act as a
	  test target driven from the host over the bus (control frames on ID
	  0x7E0/0x7E8; see can_bench/ and CAN_BENCH_REPORT.md).  Loops forever;
	  never enable in a production image.

config APP_KLINE_TEST
	bool "Run the K-wire transceiver loopback test at boot"
	default n
	help
	  At startup, stream a run of bytes K1 -> K2 and K2 -> K1 over the shared
	  K-line to verify the two transceivers talk to each other across the
	  wire.  Bench bring-up aid; leave off in production.

config APP_KLINE_INIT_AT_BOOT
	bool "Open a KWP2000 (ISO 14230) session with the vehicle over K at boot"
	default n
	depends on APP_BOARD_HAS_KLINE
	help
	  At startup, power the K-line transceiver and try to open a
	  diagnostic session with the vehicle: first the 5-baud init
	  (ISO 14230-2, the one ISO 9141-2 also uses: address 0x33, sync
	  byte, key bytes), and
	  if nothing answers, the ISO 14230-4 fast init (25 ms wake-up pulse
	  plus one StartCommunication request), first on the OBD functional
	  address and then swept across every physical ECU address, and
	  finally the 5-baud init swept the same way.  No other request is
	  sent;
	  the result — which init worked, what protocol answered, or where
	  the handshake stopped — is printed on the console, sent as an
	  alert as soon as the modem is up (priority 1 if a session opened,
	  0 otherwise), and the tracker then starts as normal.  In-vehicle bring-up aid; leave off in
	  production.

config APP_KLINE_BAUD
	int "K-line data rate for the handshake and any session (bps)"
	depends on APP_KLINE_INIT_AT_BOOT
	default 10400
	help
	  ISO 14230-4 (and ISO 9141-2) fix this at 10400.  Some ECUs answer
	  the 5-baud init at 9600 instead; the slow init retries at the
	  other of the two automatically when the sync byte does not decode,
	  so set this to whichever the vehicle turned out to use.

config APP_KLINE_INIT_FAST
	bool "Try the ISO 14230-4 fast init as well as the 5-baud init"
	depends on APP_KLINE_INIT_AT_BOOT
	default y
	help
	  After an unanswered 5-baud init on 0x33, send the KWP2000 fast
	  init (wake-up pulse plus StartCommunication) on 0x33, once with
	  the standard 5 ms inter-byte gap and once back to back, and — if
	  APP_KLINE_INIT_SWEEP is on — sweep it across every physical
	  address before the 5-baud sweep.  Turn off for an ECU already
	  known to answer the 5-baud init: it skips ~2.5 minutes of pulses
	  the ECU ignores.

config APP_KLINE_INIT_ADDRS
	string "5-baud addresses to capture from after 0x33 (hex, comma-separated)"
	depends on APP_KLINE_INIT_AT_BOOT
	default ""
	help
	  Addresses already known to answer the 5-baud init, e.g. "13,29,58,B4".
	  Each is sent in turn and everything the ECU replies is recorded at
	  the bit rate measured from its sync byte and dumped as hex with the
	  inter-byte gaps, instead of being forced through the key-byte
	  handshake.  For working out an unrecognised protocol.
	  Empty = skip.

config APP_KLINE_INIT_ACK
	bool "Send the inverted second byte during capture"
	depends on APP_KLINE_INIT_AT_BOOT
	default y
	help
	  In capture mode, after the ECU's burst goes quiet, reply with the
	  bitwise inverse of its second byte — what a 5-baud-init tester
	  sends — and record what that provokes.  Turn off to observe the
	  ECU without ever transmitting after the address.

config APP_KLINE_INIT_SWEEP
	bool "Sweep physical ECU addresses when 0x33 gets no answer"
	depends on APP_KLINE_INIT_AT_BOOT
	default y
	help
	  After the slow and fast inits on the OBD functional address 0x33
	  both go unanswered, try the fast init and then the 5-baud init on
	  every physical address 0x01-0xFE.  Up to ~15 minutes.  Turn off
	  when the vehicle is known to answer a generic scanner, in which
	  case 0x33 is the only address that matters.

config APP_KLINE_INIT_DIAG
	bool "Operator line diagnostics before the init (L hold + listen)"
	depends on APP_KLINE_INIT_AT_BOOT
	default n
	help
	  Before the init: hold the L pulldown on for 5 s so pin 15 can be
	  metered (expect ~0 V), then listen on K for 20 s and count level
	  changes — the operator grounds pin 7 to pin 4 by hand during the
	  window.  Proves the two things the transceiver echo cannot: that L
	  really goes low, and that a low on the wire reaches the receiver.

config APP_BOARD_TEST
	bool "Run the interactive board bring-up test instead of the tracker"
	default n
	help
	  Walks an operator through every fitted subsystem over the serial
	  console: rail switching, ignition sense + wake, battery voltage,
	  tilt/impact/movement-wake on the IMU, a raw (unassisted) GPS fix,
	  modem + DNS, and the K-line/CAN loopbacks.  Driven by board_test.sh,
	  which generates the overlay that sets this.  Never enable in a
	  production image — main() runs the test and parks.

config APP_LTE_POWER_TEST
	bool "Run the LTE TX power / brown-out test instead of the tracker"
	default n
	help
	  Bring the modem up, then idle with LED1 on.  An ignition OFF->ON
	  edge — or ENTER on the serial console, when USB is attached —
	  starts a ~10 s burst of uplink UDP traffic pushed at the modem as
	  fast as it will queue it, keeping the radio transmitting for the
	  whole window: the sustained-TX supply load of a unit in a
	  low-signal area.  The ignition trigger is the one to use when
	  measuring draw, since USB takes over the power input and a
	  PSU-only run has no console; it needs APP_DEBUG_IGNITION=-1 (the
	  live GPIO read).  LED2 joins LED1 during the burst; surviving it
	  lights all three LEDs, held until ignition is turned OFF — which
	  also re-arms the trigger.  A brown-out resets the board instead,
	  so LED3 never lights and the unit comes back up at LED1 only.  Bench aid for validating the
	  supply; never enable in a production image — main() runs the test
	  and never enters the tracker.

config APP_DEMO_MODE
	bool "Demo mode: mask the GPS coordinates in the serial log"
	default n
	help
	  Replaces latitude and longitude with a placeholder everywhere the
	  firmware prints them on the console: the telemetry records echoed by
	  send_data() and the position alerts raised by the locate/tomtom
	  commands, and the board test's raw-fix line.  Only the console view is
	  masked — the record and the alert text still carry the real fix to the
	  server — so a live unit can be demonstrated in public without showing
	  where it is.

config APP_BOARD_TEST_HIDE_COORDS
	bool "Board test: do not print the GPS fix coordinates"
	default n
	help
	  The raw-fix test reports sats/HDOP/altitude/time and drops lat/lon
	  from the line entirely.  APP_DEMO_MODE already masks them there, which
	  keeps the line's shape and is usually what a demo wants; this is the
	  stricter option for when the field should not appear at all, and it
	  wins if both are set.  Set it in local.conf; board_test.sh copies it
	  into the generated test overlay.

config APP_BOARD_TEST_SKIP_MODEM
	bool "Board test: skip the modem + DNS test"
	default n
	help
	  Set by board_test.sh when no APN is configured and the operator
	  chose to skip the modem test.

config APP_PSK_HEX
	string "32-byte device PSK as 64 hex chars"
	default ""
	help
	  Pre-shared key for the ChaCha20-Poly1305 telemetry envelope.  Leave
	  empty to fall back to PSK_HEX_DEFAULT in config.h (the placeholder
	  all-zero key disables sends).  Real device keys should be provisioned
	  out-of-band, never checked in.

config APP_SERVER_HOST
	string "Telemetry server hostname"
	default ""
	help
	  Telemetry endpoint hostname (used for DNS resolution and TLS SNI).
	  Leave empty to fall back to HOSTNAME in config.h.

config APP_APN
	string "Cellular APN"
	default ""
	help
	  Network APN.  Leave empty to fall back to DEFAULT_APN in config.h.

# --- over-the-air updates ---------------------------------------------------

menuconfig APP_FOTA
	bool "Over-the-air application updates"
	default y
	select FOTA_DOWNLOAD
	select DOWNLOADER
	select DFU_TARGET
	select DFU_TARGET_MCUBOOT
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	select STREAM_FLASH
	select FLASH
	select FLASH_MAP
	select REST_CLIENT
	select HTTP_CLIENT
	help
	  Fetch a version manifest over HTTPS at power-on and on each engine-off
	  telemetry wake, and install the image it advertises when that version
	  is newer than this build.  Requires MCUboot (sysbuild.conf) — the
	  download lands in the secondary slot and the bootloader swaps it in on
	  the next boot.  See FOTA.md.

if APP_FOTA

config APP_FOTA_HOST
	string "Update server hostname"
	default ""
	help
	  Host serving the manifest and the signed images.  Leave empty to reuse
	  APP_SERVER_HOST (the telemetry endpoint), which is also what the CA at
	  APP_FOTA_SEC_TAG was issued for.

config APP_FOTA_PORT
	int "Update server port"
	default 65481
	help
	  Defaults to the telemetry TLS port: public 443 terminates on a
	  different host, but this port is already forwarded to the tracker
	  server, whose TLS listener sniffs the first two bytes and serves
	  HTTP range requests for /fw/* alongside the telemetry protocol
	  (_handle_fw_http in the server's main.py).

config APP_FOTA_SEC_TAG
	int "Modem sec_tag holding the update server's CA (-1 = plain HTTP)"
	default 42
	help
	  modem_provision_tls() installs the l0destar CA from src/ca_cert.h
	  here on first boot, so the same private CA authenticates telemetry
	  and updates.  It is deliberately NOT the telemetry TLS_SEC_TAG:
	  past DTLS/PSK experiments left extra credential types on tag 1 in
	  modem NVM, and a mixed tag makes certificate-mode TLS connect()
	  fail with EINVAL.  A dedicated tag holds one CA chain and nothing
	  else.  Set -1 to fetch over plain HTTP; the image is still
	  signature-checked by MCUboot, but the manifest and the URL it names
	  are then unauthenticated.

config APP_FOTA_MANIFEST_PATH
	string "Manifest path on the update server"
	default "/fw/manifest.txt"
	help
	  Requested with ?imei=<imei>&v=<running version> appended so a dynamic
	  endpoint can stage rollouts per device.  A static file server ignores
	  the query string.

config APP_FOTA_MIN_BATTERY_MV
	int "Minimum battery voltage to install an update (mV)"
	default 12000
	help
	  Below this the check still runs but the download is deferred to the
	  next one, so a weak battery is never asked to carry a multi-minute
	  radio session plus a flash write.

config APP_FOTA_REQUIRE_BATTERY_READING
	bool "Block updates when the battery voltage is unknown"
	default n
	help
	  A reading below IMPLAUSIBLE_VOLTAGE (5 V) means no INA228 rather than
	  a flat battery — on the bench there is no vehicle supply at all.  By
	  default that case is allowed to update; enable this to require a real
	  measurement above the threshold instead.

config APP_FOTA_DOWNLOAD_ATTEMPTS
	int "Download attempts per update check"
	default 3
	range 1 10
	help
	  The image is fetched as a long run of sequential ranged GETs on one
	  connection with no resume, so a single radio stall loses the whole
	  transfer.  Retry this many times within one check before giving up
	  and waiting for the next one.  All attempts share the wake's already
	  established radio session.

config APP_FOTA_RETRY_DELAY_S
	int "Delay between download attempts (seconds)"
	default 10
	range 0 300
	help
	  Settling time between attempts within a check.  The watchdog is fed
	  across the wait.

config APP_FOTA_RESCAN_ON_RETRY
	bool "Force a PLMN re-scan before the last download attempt"
	default y
	help
	  Retrying on the same cell only helps a transient stall.  A stationary
	  unit camped on a marginal cell fails every attempt until something
	  makes it reselect, so escalate to a full cell/PLMN re-scan before the
	  final try.  Needs APP_FOTA_DOWNLOAD_ATTEMPTS >= 2 to have any effect.

config APP_FOTA_NBIOT_DEFERRALS
	int "Checks to defer while stuck on NB-IoT (0 = never defer)"
	default 3
	range 0 20
	help
	  NB-IoT moves telemetry fine and a ~275 KB image barely at all.  When a
	  check finds the modem on NB-IoT, re-scan for LTE-M first; if it is
	  still NB-IoT, skip the download rather than spend minutes of radio
	  time on it.  After this many consecutive deferrals, attempt anyway —
	  otherwise a unit somewhere NB-IoT is all there is would never update.
	  Set 0 to always attempt regardless of access technology.

config APP_FOTA_RESCAN_TIMEOUT_S
	int "Seconds to wait for registration after a PLMN re-scan"
	default 90
	range 10 600
	help
	  The watchdog is fed while waiting.

config APP_FOTA_RETRY_HOLDOFF_S
	int "Holdoff after a failed update attempt (seconds)"
	default 600
	help
	  Checks are driven by the server (fota=<version> on each telemetry
	  response) plus one unconditional check at power-on, so there is no
	  periodic polling to rate-limit.  This holdoff only gates retries
	  after a failed attempt — the server keeps advertising the same
	  version on every response, and without it each send would burn a
	  fresh download attempt.  Doubles per consecutive failure, up to 8x.
	  A bare `fota` command overrides it.

config APP_FOTA_MANIFEST_TIMEOUT_S
	int "Manifest request timeout (seconds)"
	default 30

config APP_FOTA_DOWNLOAD_TIMEOUT_S
	int "Image download timeout (seconds)"
	default 1200
	help
	  Upper bound on the whole download.  A ~300 KB image over LTE-M
	  typically takes 2-5 minutes; the watchdog is fed throughout.

config APP_FOTA_FRAGMENT_SIZE
	int "HTTP range request size (0 = single continuous response)"
	default 0

endif # APP_FOTA

